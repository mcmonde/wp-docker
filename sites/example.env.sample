# Copy to sites/<id>.env, or run: ./add-site.sh <id> <domain>
# <id> is the Compose service name: a letter, then letters, numbers, or underscores.
# ./generate-env.sh writes DB_PASSWORD, WordPress keys, and FPM tuning when missing.
# See docs/USAGE.md for every variable and how to change them safely.
DOMAIN=example.com
WP_HOME=http://example.com
DB_NAME=example
DB_USER=example
DB_PREFIX=wp_
# Used when ALLOCATE_RESOURCES=yes. 1 is a fair share. 2 is twice a weight-1 site.
ALLOCATION_WEIGHT=1

# DigitalOcean Spaces (see docs/SPACES.md). ./generate-env.sh adds these when missing.
# SPACES_BUCKET / SPACES_REGION inside URLs are replaced with the values above.
SPACES_ENABLED=no
SPACES_KEY=your-key-do-space-here
SPACES_SECRET=your-secret-do-space-here
SPACES_BUCKET=bucket-name-here
SPACES_REGION=sgp1
SPACES_ENDPOINT=https://SPACES_BUCKET.SPACES_REGION.digitaloceanspaces.com
SPACES_PUBLIC_URL=https://SPACES_BUCKET.SPACES_REGION.cdn.digitaloceanspaces.com
SPACES_PREFIX=example
SPACES_PATH_STYLE=no
