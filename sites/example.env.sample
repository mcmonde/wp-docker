# Copy to sites/<id>.env, or run: ./add-site.sh <id> <domain>
# <id> is the Compose service name: a letter, then letters, numbers, or underscores.
# ./generate-env.sh writes DB_PASSWORD, WordPress keys, and FPM tuning when missing.
# See docs/USAGE.md for every variable and how to change them safely.
DOMAIN=example.com
WP_HOME=http://example.com
DB_NAME=example
DB_USER=example
DB_PREFIX=wp_
# Used when ALLOCATE_RESOURCES=yes. 1 is a fair share. 2 is twice a weight-1 site.
ALLOCATION_WEIGHT=1

# Optional: offload media uploads to DigitalOcean Spaces (see docs/SPACES.md).
# SPACES_ENABLED=yes
# SPACES_KEY=your-spaces-access-key
# SPACES_SECRET=your-spaces-secret-key
# SPACES_BUCKET=my-wp-uploads
# SPACES_REGION=nyc3
# SPACES_PREFIX=example
# SPACES_PUBLIC_URL=https://my-wp-uploads.nyc3.cdn.digitaloceanspaces.com
# SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
