# =========================
# WordPress Core (ignore)
# =========================
/wp-admin/
/wp-includes/
/index.php
/*.php
/*.html

# =========================
# wp-content (selective)
# =========================

# Ignore everything first
wp-content/*

## But keep structure (empty folders)
#!wp-content/plugins/
#!wp-content/themes/
#!wp-content/uploads/
#!wp-content/mu-plugins/
#!wp-content/languages/

## Keep important file
#!wp-content/index.php

## =========================
## Runtime/generated folders
## =========================
#wp-content/uploads/*
#wp-content/upgrade/*
#wp-content/cache/*
#wp-content/backups/*
#wp-content/wflogs/*
#wp-content/ai1wm-backups/*

# =========================
# Plugins/themes (optional strategy)
# =========================
# Uncomment if you want to track code only
# !wp-content/plugins/your-plugin/
# !wp-content/themes/your-theme/

# =========================
# Docker / environment
# =========================
.env
.env.*
docker-compose.override.yml
docker-compose.sites.yml
mysql/init/*.sql

# Site secrets and per-instance wp-content. The sample file stays tracked.
sites/*
!sites/example.env.sample

# Credentials, dumps, and private keys. *.example files stay tracked.
*.env
*.sql
*.sql.gz
*.sqlite
*.p12
*.pfx
id_rsa
id_ed25519
*.key
!*.key.example
*.crt
!*.crt.example
*.pem
!*.pem.example

# Recreated by generate-env.sh, tuned to this server.
php/pools/*.conf
nginx/conf.d/*.conf
mysql/my.cnf
php/custom.ini

# Real certificates placed next to the examples.
certs/*.key
certs/*.crt
certs/*.pem

# =========================
# Logs
# =========================
*.log

# CUSTOM IGNORES
.idea
backups
certs/live/
certs/archive/
certs/accounts/
certs/renewal/
certs/renewal-hooks/
nginx/logs/*
wp-config.php